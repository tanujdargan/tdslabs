# Copy to .env (or load via your process manager) and adjust as needed.

NODE_ENV=production

# --- Server ---------------------------------------------------------------
ARTIFACT_KEEPER_HOST=0.0.0.0
ARTIFACT_KEEPER_PORT=8787
# Public base URL shown in share links (no trailing slash). Optional.
# ARTIFACT_KEEPER_BASE_URL=https://artifacts.example.com

# Where the SQLite database and cloned snapshots live.
ARTIFACT_KEEPER_DATA_DIR=./data

# Persisted automatically if unset; set explicitly to keep sessions valid
# across redeploys or when running multiple instances.
# ARTIFACT_KEEPER_SESSION_SECRET=change-me-to-a-long-random-string

# Set to true only when served over HTTPS (e.g. behind a reverse proxy).
# ARTIFACT_KEEPER_SECURE_COOKIE=false

# --- First-run admin (optional, unattended installs) ----------------------
# Used only when no user exists yet.
# ARTIFACT_KEEPER_ADMIN_USER=admin
# ARTIFACT_KEEPER_ADMIN_PASSWORD=change-me-please

# --- Scheduler ------------------------------------------------------------
# Default re-check interval (minutes) for new artifacts.
ARTIFACT_KEEPER_DEFAULT_INTERVAL=360
# How often the scheduler wakes to look for due artifacts (cron syntax).
ARTIFACT_KEEPER_SCHEDULER_CRON=*/5 * * * *

# --- Cloning --------------------------------------------------------------
# Explicit path to Chromium/Chrome. Leave empty to auto-detect.
# ARTIFACT_KEEPER_CHROMIUM_PATH=/usr/bin/chromium
# Disable headless rendering and use plain HTTP fetch instead.
# ARTIFACT_KEEPER_DISABLE_BROWSER=false
# Page settle timeout in milliseconds.
# ARTIFACT_KEEPER_CLONE_TIMEOUT_MS=45000
